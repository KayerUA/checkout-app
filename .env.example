# App
APP_URL=https://checkout.kayer.ua
NODE_ENV=development

# Database (Railway Postgres in production)
DATABASE_URL=postgresql://checkout:checkout@localhost:5432/checkout

# Redis (Railway Redis in production)
REDIS_URL=redis://localhost:6379
WORKER_HEARTBEAT_REQUIRED=false

# Session encryption (min 32 chars) — generate unique values for production
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# Token encryption (32-byte hex = 64 chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Shopify App (kayer custom app — see docs/kayer/SHOPIFY_SETUP.md)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SHOP_DOMAIN=kayer.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_SCOPES=read_products,read_orders,write_orders,read_inventory,read_customers,write_draft_orders,read_locations
SHOPIFY_API_VERSION=2026-01

# Internal admin and jobs protection
ADMIN_PASSWORD=change-me-admin-password
INTERNAL_JOBS_SECRET=change-me-internal-jobs-secret

# Sentry (optional)
SENTRY_DSN=

# LiqPay keys are stored per-merchant in Admin → Payments (not in env)
# Monobank is not used for kayer MVP

# Nova Poshta — required for city/branch lookup and dictionary sync
NOVA_POSHTA_API_KEY=

# Checkbox (not used in kayer MVP)
CHECKBOX_API_URL=https://api.checkbox.in.ua/api/v1

# Supabase (Postgres is used through DATABASE_URL; Storage uses REST)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_DOCUMENTS_BUCKET=b2b-documents

# B2B documents email
RESEND_API_KEY=
DOCUMENTS_FROM_EMAIL=docs@kayer.ua

# Seller legal/payment details for invoices
SELLER_NAME=
SELLER_TAX_ID=
SELLER_IBAN=
SELLER_BANK_NAME=
SELLER_LEGAL_ADDRESS=
SELLER_PHONE=
SELLER_SIGNATURE_NAME=

# Bank reconciliation
BANK_PROVIDER=mock
BANK_API_URL=
BANK_API_TOKEN=
BANK_ACCOUNT_IBAN=

# Fiscalization extension points
FISCALIZATION_PROVIDER=noop
CHECKBOX_API_KEY=
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_SECRET_KEY=

# Accounting / fulfillment integration placeholders
# Use these after confirming the actual DiloShop/Dilovod API contract.
ACCOUNTING_PROVIDER=none
DILOSHOP_API_URL=
DILOSHOP_API_KEY=
DILOSHOP_WEBHOOK_URL=
DILOSHOP_NP_WEBHOOK_URL=
DILOSHOP_NP_FLOW_SECRET=
DILOSHOP_WEBHOOK_SECRET=
DILOVOD_API_URL=
DILOVOD_API_KEY=

# Cron protection; falls back to INTERNAL_JOBS_SECRET if omitted
CRON_SECRET=

# Local dev: use ngrok for LiqPay callbacks
# APP_URL=https://xxxx.ngrok-free.app

# A/B checkout router (Chekly vs custom)
CHECKOUT_AB_EXPERIMENT_ID=checkout_router_2026_06
CHEKLY_WEIGHT=95
CUSTOM_WEIGHT=5
CUSTOM_CHECKOUT_ENABLED=true
CHEKLY_CHECKOUT_URL=/checkout
KAYER_SHOP_DOMAIN=kayer.myshopify.com
CHECKOUT_AB_VISITOR_COOKIE=kayer_ab_vid
