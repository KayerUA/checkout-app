{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/reconcile-payments",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/reconcile-orders",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cron/reconcile-fiscal",
      "schedule": "10 0 * * *"
    },
    {
      "path": "/api/cron/maintenance?job=abandoned",
      "schedule": "20 0 * * *"
    },
    {
      "path": "/api/cron/maintenance?job=nova-poshta",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/reconcile-bank-payments",
      "schedule": "30 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/kayer-checkout.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/checkout-ab-intercept.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
